---
// ==========================================
// CONFIGURAÇÕES DE DESIGN E CORES
// ==========================================

// Altura da seção do Header / Topo
const HEADER_HEIGHT = "500px"; 

// Cor do Fundo Geral da Página
const BG_COLOR = "#dcfddd"; 

// Tons de Verde para Botões, Badges e Detalhes
const GREEN_PRIMARY = "#71f082";  
const GREEN_SECONDARY = "#71f082"; 

// CONFIGURAÇÃO DAS BOLINHAS DO FUNDO
const GRID_SPEED = "6s"; 
const GRID_COLOR = "rgba(0, 0, 0, 1)"; 

// CONFIGURAÇÃO DA FLUTUAÇÃO SUAVE DOS CARDS / SEÇÕES
const CARD_FLOAT_OFFSET = "-6px";
const CARD_FLOAT_SPEED = "3s";

// CONFIGURAÇÃO DA TAG SOBRE MIM
const SOBRE_MIM_SCALE = "1.08";
const SOBRE_MIM_SPEED = "2.5s";

// ==========================================
// CONTROLE TOTAL DOS RECORDES DE JORNAL (LETRAS)
// ==========================================

// 1. Ativar / Desativar a Animação Stop-Motion das letras
const ENABLE_LETTER_ANIMATION = true; 

// 2. Cores de Fundo das Letras
const LETTER_BG_COLORS = ["#ffffff", "#71f082", "#ffffff", "#a8ffb6"];

// 3. Velocidade da Animação das Letras
const CUTOUT_SPEED = "2s";

// 4. Quantidade de quadros do Stop-Motion
const CUTOUT_STEPS = 3; 

// 5. Intensidade do MOVIMENTO / Tremor
const JITTER_INTENSITY = 1;

// ==========================================
// DADOS PESSOAIS, EXPERIÊNCIAS E PROJETOS
// ==========================================
const portfolioText = "PORTFOLIO";
const yearText = "2026";
const aboutText = "SOBRE MIM";
const featuredText = "PROJETOS";
const contactText = "CONTATO";

interface Links {
  github?: string;
  itchio?: string;
  steam?: string;
}

interface Project {
  title: string;
  category: string;
  description: string;
  tags: string[];
  youtubeId?: string;
  screenshots?: string[]; 
  links?: Links;
}

interface Experience {
  company: string;
  logo: string;
}

// SUAS EXPERIÊNCIAS PROFISSIONAIS (Adicione ou altere aqui)
const experiences: Experience[] = [
  {
    company: "Grupo RBS - Programadora",
    logo: "prints/rbs-tv-logo.png",
  },
  {
    company: "Bad Moth - Programadora",
    logo: "prints/badmoth.jpeg",
  },
  {
    company: "Little Devil - Artista Técnico",
    logo: "prints/little_devil-Photoroom.png",
  },
    {
    company: "Editora de Vídeos - Freelancer",
    logo: "prints/camera_icon.png",
  },
];

const projects: Project[] = [
  {
    title: "STACKED PIRATES",
    category: "Puzzle 3D isométrico de piratas procurando por um tesouro.",
    description: "Um jogo de puzzle em que você usa seus piratas para conseguir atingir locais e passar por certas áreas atrás do seu objetivo de encontrar o baú soterrado pelo mapa. O projeto está sendo produzido para uma disciplina da faculdade e contém o foco na mecânica de utilizar a pilha de piratas para conseguir navegar no mapa e conseguir passar pelas fases. O jogo tem uma estética low-poly e tem uma estilização cartoon feita por meio de shaders e efeitos visuais. Este projeto foi feito inteiramente por mim, desde a parte visual até a parte do código.",
    tags: ["C#", "Unity", "Shaders", "Blender"],
    youtubeId: "???",
    screenshots: [
      "prints/Capivarinha20-20Thassiane20Targino20-20Ipram2028129.png",
    ],
    links: {
      github: "https://github.com"
    }
  },
  {
    title: "Spell Slot",
    category: "????",
    description: "????",
    tags: ["C#", "Unity"],
    screenshots: [
      "/prints/outro-1.png"
    ],
    links: {
      github: "https://github.com",
      itchio: "https://itch.io"
    }
  },
  {
    title: "OUTRO JOGO",
    category: "????",
    description: "????",
    tags: ["C#", "Unity"],
    screenshots: [
      ""
    ],
    links: {
      github: "https://github.com",
      itchio: "https://itch.io"
    }
  }
];

function createPaperLetters(text: string) {
  return text.split("").map((letter, idx) => {
    const baseRot = ((Math.random() * 16 - 8) * JITTER_INTENSITY).toFixed(1); 
    const jitterRot = ((Math.random() * 12 - 6) * JITTER_INTENSITY).toFixed(1);

    const offsetX = ((Math.random() * 8 - 4) * JITTER_INTENSITY).toFixed(1);
    const offsetY = ((Math.random() * 10 - 5) * JITTER_INTENSITY).toFixed(1);

    const fontStyles = ["font-black", "font-bold", "font-extrabold"];
    const fontStyle = fontStyles[idx % fontStyles.length];

    const delay = (Math.random() * 1.2).toFixed(2);
    const bgColor = LETTER_BG_COLORS[idx % LETTER_BG_COLORS.length];

    return { 
      letter, 
      baseRot: `${baseRot}deg`, 
      jitterRot: `${jitterRot}deg`,
      offsetX: `${offsetX}px`,
      offsetY: `${offsetY}px`,
      fontStyle,
      delay: `${delay}s`,
      bgColor
    };
  });
}

const portfolioLetters = createPaperLetters(portfolioText);
const yearLetters = createPaperLetters(yearText);
const aboutLetters = createPaperLetters(aboutText);
const featuredLetters = createPaperLetters(featuredText);
const contactLetters = createPaperLetters(contactText);
---

