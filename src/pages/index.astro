              <!-- VÍDEO DO YOUTUBE -->
              {project.youtubeId && (
                <div class="w-full aspect-video border-4 border-black rounded-2xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] bg-black group">
                  <iframe 
                    class="w-full h-full group-hover:scale-102 transition-transform duration-300"
                    src={`https://www.youtube.com/embed/${project.youtubeId}`}
                    title={project.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              )}

              <!-- GALERIA DE FOTOS / PRINTS -->
              {project.screenshots && project.screenshots.length > 0 && (
                <div class="grid grid-cols-2 gap-3">
                  {project.screenshots.map((imgUrl, imgIdx) => (
                    <div class="aspect-video border-2 md:border-3 border-black rounded-xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] bg-zinc-100 group cursor-pointer">
                      <img 
                        src={imgUrl} 
                        alt={`${project.title} screenshot ${imgIdx + 1}`} 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" 
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              )}

            </div>

            <!-- DETALHES DO PROJETO -->
            <div class="flex flex-col justify-between w-full space-y-6">
              <div class="space-y-3">
                <h3 class="text-3xl font-black uppercase tracking-tight">{project.title}</h3>
                <p class="text-sm font-bold text-black">{project.category}</p>
                <p class="text-zinc-700 font-medium leading-relaxed">{project.description}</p>
                
                <!-- TAGS -->
                <div class="flex flex-wrap gap-2 pt-2">
                  {project.tags.map(tag => (
                    <span 
                      class="border-2 border-black text-xs font-bold px-3 py-1 rounded-lg shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:scale-110 transition-transform duration-150 cursor-default"
                      style={`background-color: ${GREEN_SECONDARY};`}
                    >
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- BOTÕES DO PROJETO -->
              {project.links && (
                <div class="flex flex-wrap gap-3 pt-4 border-t-2 border-zinc-100">
                  
                  {project.links.github && (
                    <a 
                      href={project.links.github} 
                      target="_blank" 
                      class="border-2 border-black text-black font-extrabold text-sm px-4 py-2.5 rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:scale-105 hover:-rotate-1 active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 flex items-center gap-2"
                      style={`background-color: ${GREEN_PRIMARY};`}
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                      GitHub Code
                    </a>
                  )}

                  {project.links.itchio && (
                    <a 
                      href={project.links.itchio} 
                      target="_blank" 
                      class="border-2 border-black text-black font-extrabold text-sm px-4 py-2.5 rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:scale-105 hover:rotate-1 active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 flex items-center gap-2"
                      style={`background-color: ${GREEN_SECONDARY};`}
                    >
                      🎮 itch.io
                    </a>
                  )}

                  {project.links.steam && (
                    <a 
                      href={project.links.steam} 
                      target="_blank" 
                      class="border-2 border-black text-black font-extrabold text-sm px-4 py-2.5 rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:scale-105 hover:-rotate-1 active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 flex items-center gap-2"
                      style={`background-color: ${GREEN_PRIMARY};`}
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.03 4.524 4.524s-2.03 4.524-4.524 4.524h-.105l-4.076 2.911c.002.052.006.105.006.158 0 1.807-1.465 3.272-3.272 3.272-1.42 0-2.636-.905-3.087-2.164L.171 15.31C1.36 20.33 5.867 24 11.979 24c6.627 0 12-5.373 12-12s-5.373-12-12-12z"/></svg>
                      Steam Wishlist
                    </a>
                  )}

                </div>
              )}

            </div>

          </article>
        ))}

      </section>

      <!-- SEÇÃO DE CONTATOS -->
      <section id="contato" class="relative bg-white border-4 border-black rounded-3xl p-6 md:p-10 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] animate-card-float hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] transition-all duration-300">
        
        <!-- TÍTULO CONTATOS -->
        <div class="flex items-center justify-center mb-8">
          <h2 class="text-2xl md:text-4xl uppercase flex flex-wrap gap-1.5 items-center justify-center py-2">
            {contactLetters.map((item) => (
              item.letter === " " ? (
                <span class="w-3 md:w-5"></span>
              ) : (
                <span 
                  class={`inline-flex items-center justify-center border-2 border-black text-black px-2 py-0.5 md:px-2.5 md:py-1 rounded-sm shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:scale-125 hover:z-20 transition-transform duration-150 cursor-pointer ${ENABLE_LETTER_ANIMATION ? 'animate-paper-cutout' : ''} ${item.fontStyle}`}
                  style={`
                    --base-rot: ${item.baseRot};
                    --jitter-rot: ${item.jitterRot};
                    --offset-x: ${item.offsetX};
                    --offset-y: ${item.offsetY};
                    animation-delay: ${item.delay};
                    background-color: ${item.bgColor};
                    transform: rotate(${item.baseRot});
                  `}
                >
                  {item.letter}
                </span>
              )
            ))}
          </h2>
        </div>

        <!-- OPÇÕES DE CONTATO COM BORDA PRETA GARANTIDA -->
        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href="mailto:seuemail@exemplo.com" 
            class="border-2 border-black text-black font-extrabold px-6 py-3 rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:scale-105 hover:-rotate-1 active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 flex items-center gap-2 text-base"
            style={`background-color: ${GREEN_PRIMARY};`}
          >
            Email
          </a>
          <a 
            href="https://linkedin.com" 
            target="_blank"
            class="border-2 border-black text-black font-extrabold px-6 py-3 rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:scale-105 hover:rotate-1 active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 flex items-center gap-2 text-base"
            style={`background-color: ${GREEN_SECONDARY};`}
          >
            Exemplo
          </a>
          <a 
            href="https://itch.io" 
            target="_blank"
            class="border-2 border-black text-black font-extrabold px-6 py-3 rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:scale-105 hover:-rotate-1 active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 flex items-center gap-2 text-base"
            style={`background-color: ${GREEN_PRIMARY};`}
          >
            Exemplo
          </a>
        </div>

      </section>

    </main>

    <!-- ESTILOS E ANIMAÇÕES DE MOVIMENTO -->
    <style>
      /* PADRÃO DE GRADE DE FUNDO */
      .bg-grid-pattern {
        background-image: radial-gradient(var(--grid-color) 2.5px, transparent 2.5px);
        background-size: 26px 26px;
        animation: gridMove var(--grid-speed) linear infinite;
      }

      @keyframes gridMove {
        0% { background-position: 0 0; }
        100% { background-position: 26px 26px; }
      }

      /* RECORTE DE JORNAL - CHAVE DE CORES E MOVIMENTO */
      @keyframes paperCutoutAnimation {
        0%, 100% {
          transform: rotate(var(--base-rot)) translate(0px, 0px);
        }
        33% {
          transform: rotate(calc(var(--base-rot) + var(--jitter-rot))) translate(var(--offset-x), var(--offset-y));
        }
        66% {
          transform: rotate(calc(var(--base-rot) - var(--jitter-rot))) translate(calc(var(--offset-x) * -1), calc(var(--offset-y) * -1));
        }
      }

      .animate-paper-cutout {
        animation: paperCutoutAnimation var(--cutout-speed) steps(var(--cutout-steps)) infinite;
      }

      /* FLUTUAÇÃO SUAVE DOS CARDS */
      @keyframes cardFloat {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(var(--card-float-offset)); }
      }

      .animate-card-float {
        animation: cardFloat var(--card-float-speed) ease-in-out infinite;
      }

      /* ANIMAÇÃO DE BALANCEI (WIGGLE) */
      @keyframes wiggleSlow {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-2deg); }
        75% { transform: rotate(2deg); }
      }

      .animate-wiggle-slow {
        animation: wiggleSlow 4s ease-in-out infinite;
      }
    </style>
  </body>
</html>